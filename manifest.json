                "key": "genres",
                "kind": "collections",
                "label": "$t:tab.genres",
                "order": "count",
                "searchPlaceholder": "$t:search.genres",
                "sort": "rating"
              },
              {
                "direction": "desc",
                "filters": {
                  "match": "all",
                  "rules": [
                    { "field": "viewer", "op": "is", "value": { "history": true } }
                  ]
                },
                "key": "history",
                "kind": "view",
                "label": "$t:tab.history",
                "layout": "timeline",
                "searchPlaceholder": "$t:search.reading_history",
                "sort": "lastViewed"
              },
              {
                "direction": "desc",
                "filters": {
                  "match": "all",
                  "rules": [
                    {
                      "field": "viewer",
                      "op": "is",
                      "value": { "watchlist": true }
                    }
                  ]
                },
                "key": "to-read",
                "kind": "view",
                "label": "$t:tab.to_read",
                "layout": "grid",
                "searchPlaceholder": "$t:search.to_read",
                "sort": "added"
              }
            ]
          },
          "match": { "thresholdDefault": 0.65 },
          "media": "book",
          "present": {
            "mediaBrowser": {
              "collectionType": "books",
              "itemTypes": { "series": "Series", "volume": "Book" }
            },
            "vela": { "type": "movies" }
          },
          "sync": { "mode": "pull", "refresh": "6h" }
        }
      ]
    }
  }
}
